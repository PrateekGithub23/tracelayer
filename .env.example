# Copy to .env to override defaults used by docker-compose.yml. Nothing here costs money.
# .env is gitignored: never commit real values.
POSTGRES_PASSWORD=change-me-owner-password
TL_APP_PASSWORD=change-me-runtime-password
# grounded (recommended: the LLM writes only from verified facts) | auto (free-form LLM, else deterministic)
# | ollama (free-form LLM only) | deterministic (no model)
TRACELAYER_LLM_MODE=grounded
TRACELAYER_OLLAMA_MODEL=llama3.2:3b
# Optional one-time first admin (only used while the users table is empty; must change password at first login).
# Prefer `make create-admin` instead, which never puts a password in a file.
TRACELAYER_BOOTSTRAP_ADMIN_EMAIL=
TRACELAYER_BOOTSTRAP_ADMIN_PASSWORD=
